{
    "app": {
        "theme_mode": "Auto",
        "language": "zh_CN",
        "version": "1.0.0"
    },
    "dependencies": {
        "ghostscript": {
            "path": ""
        }
    },
    "plugins": {
        "enabled": {
            "pandoc": true,
            "mathjax": true,
            "highlight": true
        },
        "settings": {
            "pandoc": {
                "custom_path": "",
                "latex_engine": "xelatex"
            },
            "mathjax": {
                "use_cdn": true
            },
            "highlight": {
                "style": "default"
            }
        }
    },
    "pdf": {
        "compress": {
            "quality": "/printer",
            "default_output_dir": "Compressed"
        },
        "merge": {
            "default_output_name": "merged.pdf"
        }
    },
    "ocr": {
        "engine": "paddle",
        "language": "ch",
        "enable_gpu": false
    }
}
